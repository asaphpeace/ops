# Copy to runner/runner.env (git-ignored) and fill in.
# Shared secret — must match RUNNER_TOKEN in the app's .env.
#   python3 -c "import secrets;print(secrets.token_hex(24))"
RUNNER_TOKEN=
RUNNER_PORT=8765
AWS_UTIL_DIR=~/aws-util
# GitLab personal access token, `api` scope — only needed for real upgrades.
# Lives here on the host; never enters the app container or database.
GITLAB_TOKEN=
