# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Used by docker-compose to initialise the database container and by the
# DATABASE_URL below. Keep these three consistent with each other.
POSTGRES_USER=sedna
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sedna_ops

# Full async connection string consumed by SQLAlchemy.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
# "db" resolves to the postgres container inside Docker Compose.
DATABASE_URL=postgresql+asyncpg://sedna:changeme@db:5432/sedna_ops


# ── Auth (JWT) ────────────────────────────────────────────────────────────────
# Random secret used to sign session JWTs. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Token lifetime in minutes (default 480 = 8 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=480


# ── Google OAuth ──────────────────────────────────────────────────────────────
# Required to enable login. Leave both empty to run without auth (dev mode).
#
# Setup steps:
#   1. Go to console.cloud.google.com → APIs & Services → Credentials
#   2. Create an OAuth 2.0 Client ID (type: Web application)
#   3. Add http://localhost/api/auth/google/callback as an Authorised redirect URI
#   4. On the OAuth consent screen add sedna.com as an Authorised domain
#   5. Paste the client ID and secret below
#
# Only @sedna.com Google accounts will be allowed through.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/auth/google/callback


# ── Jira ──────────────────────────────────────────────────────────────────────
# Optional. Polling is disabled when JIRA_API_TOKEN is empty.
# JIRA_EMAIL must be the Atlassian account email used to generate the token.
# Generate an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@sedna.com
JIRA_API_TOKEN=

# How long live-Jira team-stats results (My Desk, Command Center) are cached
# in-process before a fresh fetch, in seconds. Default 3600 (1 hour).
JIRA_STATS_CACHE_TTL_SECONDS=3600


# ── Slack ─────────────────────────────────────────────────────────────────────
# Optional. Alerts and digest posts are logged locally when empty.
# Create an Incoming Webhook at: https://api.slack.com/apps → your app → Incoming Webhooks
SLACK_WEBHOOK_URL=


# ── Anthropic (AI digest & summaries) ──────────────────────────────────────────
# Optional. Morning brief, full snapshot, and customer/bug AI summaries fall
# back to a plain text template or stay unavailable when empty — nothing breaks.
# Generate a key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=


# ── Google Calendar (Upgrade scheduling sync) ──────────────────────────────────
# Optional. Upgrade slot scheduling works locally either way; this only pushes
# confirmed slots to a shared calendar when both are set.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=


# ── Dataloy VMS (machine-to-machine credential foundation) ─────────────────────
# Optional. Per-tenant credentials are stored in the database (see
# vms_api_credentials); these are only used by the token-direct VMS Sandbox path.
DATALOY_VMS_TOKEN_URL=
DATALOY_VMS_API_BASE_URL=


# ── Rovo / Atlassian Teamwork Graph (MCP) ──────────────────────────────────────
# Optional enrichment for AI summaries (linked PRs/docs via Teamwork Graph).
# Summaries work without it — this is additive context only.
ROVO_API_EMAIL=
ROVO_API_TOKEN=
ROVO_MCP_URL=https://mcp.atlassian.com/v1/mcp/authv2


# ── Local Ollama (advisory supervisor + in-app chat) ───────────────────────────
# Optional. Reached from inside the api container via Docker Desktop's
# built-in host.docker.internal resolution (Windows/Mac; no extra_hosts needed).
# Leave blank to disable — the AI Observations supervisor and Ollama chat
# simply don't run.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:4b
# Interactive-chat-specific tuning (the background supervisor uses its own
# shorter, hardcoded timeout since it's not a live request path).
OLLAMA_CHAT_TIMEOUT_SECONDS=60
OLLAMA_CHAT_NUM_CTX=8192


# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. The defaults cover local Docker
# Compose (port 80) and the Vite dev server (port 5173).
# Add your production domain here when deploying.
CORS_ORIGINS=http://localhost,http://localhost:5173


# ── Misc business constants ────────────────────────────────────────────────────
# Real DevOps upgrade-slot capacity per week — informational only on Command
# Center's schedule view, never enforced/blocking.
DEVOPS_SLOTS_PER_WEEK=6


# ── Seed data (local/demo only) ────────────────────────────────────────────────
# Never enable this in a real environment — it wipes and reseeds demo data.
SEED_ENABLED=false
