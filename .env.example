# ── DATABASE ──────────────────────────────────────────────
POSTGRES_DB=sedna_ops
POSTGRES_USER=sedna
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://sedna:changeme@db:5432/sedna_ops

# ── API ───────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string
CORS_ORIGINS=http://localhost,http://localhost:5173

# ── JIRA ─────────────────────────────────────────────────
# Leave blank to disable polling; the scheduler will skip silently
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=

# ── SLACK ─────────────────────────────────────────────────
# Leave blank to log locally only
SLACK_WEBHOOK_URL=

# ── ANTHROPIC ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── DATALOY ───────────────────────────────────────────────
# Base URL pattern for live version checks: {tenant}.dataloy.com
# No config needed — tenant subdomains resolved per-customer at runtime
